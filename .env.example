# Copy to `.env` (which is git-ignored) and adjust. These values are for a
# LOCAL, throw-away development stack only. Never commit a real `.env`.

# ---- PostgreSQL target (pipeline warehouse) ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=airquality
POSTGRES_USER=pipeline
POSTGRES_PASSWORD=change_me_locally

# ---- Airflow (docker compose only) ----
AIRFLOW_UID=50000
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change_me_locally
# Generate your own, e.g.  python -c "import secrets; print(secrets.token_hex(16))"
AIRFLOW_SECRET_KEY=change_me_locally

# ---- Pipeline overrides (optional; defaults live in config/pipeline.yml) ----
# PIPELINE_SOURCE_PATH=data/source/world_air_quality.csv
# PIPELINE_LAYER_FORMAT=parquet
# PIPELINE_MODEL_SEED=42
